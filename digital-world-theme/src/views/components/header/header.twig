<nav id="navbar">
  <div class="nav-inner">
    <a href="{{ link('/') }}" class="nav-logo">
      <div class="logo-icon">🌐</div>
      <span class="logo-text">{{ store.name }}</span>
    </a>
    <div class="nav-actions">
      {# مكون سلة الرسمي الخاص بأيقونة السلة والعداد #}
      <salla-cart-summary class="nav-btn" title="السلة">
        <i class="sicon-shopping-cart"></i>
      </salla-cart-summary>
      
      <a href="{{ link('contacts') }}" class="nav-btn" title="واتساب">📞</a>
    </div>
  </div>
</nav>

<div id="cat-strip">
  <div class="cat-list">
    <a href="{{ link('/') }}" class="cat-chip active">🏠 الكل</a>
    {% for category in store.categories %}
        <a href="{{ category.url }}" class="cat-chip">{{ category.name }}</a>
    {% endfor %}
  </div>
</div>