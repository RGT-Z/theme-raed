{% extends "layouts.master" %}

{% block content %}
  <section id="hero">
    <div class="hero-bg"></div>
    <div class="hero-particles" id="particles"></div>
    <div class="hero-content">
      <div class="hero-badge">✦ متجر رقمي موثوق ✦</div>
      <h1 class="hero-title">أهلاً بك في<br><span>{{ store.name }}</span></h1>
      <p class="hero-desc">{{ store.description }}</p>
      <div class="hero-btns">
        <a class="btn-gold" href="#products-section">🛍️ تصفح المنتجات</a>
        <a class="btn-outline" href="{{ store.social.whatsapp.url }}" target="_blank">📲 تواصل معنا</a>
      </div>
    </div>
  </section>

  <div class="gold-line"></div>

  <section class="section-alt" id="products-section">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">اختيار العملاء</div>
        <h2 class="section-title">الأكثر <span>طلباً</span></h2>
        <div class="section-divider"></div>
      </div>
      <div class="products-grid">
        {# حلقة تكرار لعرض أحدث المنتجات من منصة سلة #}
        {% for product in salla.products.latest(8) %}
            {% component 'product-card' with {product: product} %}
        {% endfor %}
      </div>
    </div>
  </section>

  <div class="gold-line"></div>

  <section id="about">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-label">من نحن</div>
        <h2 class="section-title">عن <span>{{ store.name }}</span></h2>
        <div class="section-divider"></div>
      </div>
      <div class="about-grid">
        <div class="about-features reveal">
          <div class="about-feature">
            <div class="feature-icon">⚡</div>
            <div class="feature-text">
              <h4>توصيل سريع خلال أوقات العمل</h4>
              <p>استلم طلبك بسرعة وموثوقية عالية خلال أوقات العمل الرسمية</p>
            </div>
          </div>
          <div class="about-feature">
            <div class="feature-icon">🔒</div>
            <div class="feature-text">
              <h4>منتجات أصلية 100%</h4>
              <p>جميع منتجاتنا مرخصة وأصلية من مصادر موثوقة ومعتمدة</p>
            </div>
          </div>
          <div class="about-feature">
            <div class="feature-icon">💬</div>
            <div class="feature-text">
              <h4>دعم فني طوال أيام الأسبوع</h4>
              <p>فريق دعم متخصص جاهز للمساعدة طوال أيام الأسبوع لخدمتك</p>
            </div>
          </div>
        </div>
        <div class="about-visual reveal">
          <div class="about-big-icon">🌐</div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}