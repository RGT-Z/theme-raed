<!DOCTYPE html>
<html lang="{{ theme.lang }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title|default(store.name) }}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    {# استدعاء ملفات سلة الأساسية #}
    {{ twilight_head() }}
    
    {# ملف الـ CSS الخاص بتصميمك #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>

    {# استدعاء الهيدر #}
    {% component 'header' %}

    <div id="page-home" class="page active">
        {% block content %}{% endblock %}
    </div>

    {# استدعاء الفوتر #}
    {% component 'footer' %}

    {# استدعاء سكربتات سلة #}
    {{ twilight_scripts() }}

    {# سكربت الجزيئات (Particles) وتأثيرات الظهور (Reveal) الخاصة بك #}
    <script>
        function createParticles() {
            const container = document.getElementById('particles');
            if(!container) return;
            for (let i = 0; i < 30; i++) {
                const p = document.createElement('div');
                p.className = 'particle';
                p.style.left = Math.random() * 100 + '%';
                p.style.width = p.style.height = (Math.random() * 3 + 1) + 'px';
                p.style.animationDuration = (Math.random() * 15 + 10) + 's';
                p.style.animationDelay = (Math.random() * 10) + 's';
                container.appendChild(p);
            }
        }

        function observeReveal() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) { e.target.classList.add('visible'); }
                });
            }, { threshold: 0.1 });
            
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        }

        let lastScroll = 0;
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            const strip = document.getElementById('cat-strip');
            const scroll = window.scrollY;
            
            nav.classList.toggle('scrolled', scroll > 20);
            
            if (strip) {
                if (scroll > lastScroll && scroll > 200) {
                    strip.classList.add('hidden');
                } else {
                    strip.classList.remove('hidden');
                }
            }
            lastScroll = scroll;
        });

        document.addEventListener('DOMContentLoaded', () => {
            createParticles();
            observeReveal();
        });
    </script>
</body>
</html>