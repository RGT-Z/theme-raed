<footer>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">🌐 {{ store.name }}</div>
        <p class="footer-tagline">{{ store.description }}</p>
      </div>
      <div>
        <div class="footer-col-title">روابط مهمة</div>
        <div class="footer-links">
          {% for item in menus.footer %}
            <a href="{{ item.url }}" class="footer-link">{{ item.title }}</a>
          {% endfor %}
        </div>
      </div>
      <div>
        <div class="footer-col-title">أوقات العمل</div>
        <div class="hours-grid">
          <div class="hour-row">
            <span class="hour-day">الأحد – الخميس</span>
            <span class="hour-time">9ص – 10:30م</span>
          </div>
          <div class="hour-row">
            <span class="hour-day">الجمعة - السبت</span>
            <span class="hour-time">4:40م – 10:30م</span>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="footer-copy">© {{ 'now'|date('Y') }} {{ store.name }} · جميع الحقوق محفوظة</div>
      <div class="payment-methods" style="display: flex; gap: 10px;">
        {# أيقونة مدى للأسفل #}
        <img src="{{ asset('images/mada.png') }}" alt="Mada" style="height: 24px;">
      </div>
    </div>
  </div>
</footer>